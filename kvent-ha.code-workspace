{
  "folders": [
    { "path": "." }
  ],
  "settings": {
    "editor.rulers": [160],
    "python.defaultInterpreterPath": ".venv/bin/python",
    "[windows]": {
      "python.defaultInterpreterPath": ".venv\\Scripts\\python.exe"
    },
    "editor.formatOnSave": true,
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["tests"],
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Ensure venv",
        "detail": "No-op if .venv exists; otherwise create it (Python 3.12) and install requirements-dev.txt. Wired as a dependsOn for Run tests and Lint (ruff).",
        "type": "shell",
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\ensure-venv.ps1"],
        "windows": {
          "command": "powershell",
          "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\ensure-venv.ps1"]
        },
        "linux": {
          "command": "bash",
          "args": ["${workspaceFolder}/scripts/ensure-venv.sh"]
        },
        "osx": {
          "command": "bash",
          "args": ["${workspaceFolder}/scripts/ensure-venv.sh"]
        },
        "group": "build",
        "presentation": { "reveal": "silent", "panel": "shared", "showReuseMessage": false }
      },
      {
        "label": "Recreate venv",
        "detail": "Delete .venv if present, then create a fresh one (Python 3.12) and install requirements-dev.txt. Use after upgrading Python or when requirements-dev.txt changes.",
        "type": "shell",
        "command": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\recreate-venv.ps1"],
        "windows": {
          "command": "powershell",
          "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\recreate-venv.ps1"]
        },
        "linux": {
          "command": "bash",
          "args": ["${workspaceFolder}/scripts/recreate-venv.sh"]
        },
        "osx": {
          "command": "bash",
          "args": ["${workspaceFolder}/scripts/recreate-venv.sh"]
        },
        "group": "build",
        "presentation": { "reveal": "always", "panel": "shared" }
      },
      {
        "label": "Deploy to HA (rsync / WSL)",
        "type": "shell",
        "command": "bash scripts/deploy-ha-rsync.sh",
        "windows": {
          "command": "powershell -ExecutionPolicy Bypass -File scripts\\deploy-ha-wsl.ps1"
        },
        "group": "build",
        "presentation": { "reveal": "always", "panel": "shared" }
      },
      {
        "label": "Deploy to HA (scp, no WSL)",
        "type": "shell",
        "command": "bash scripts/deploy-ha-rsync.sh",
        "windows": {
          "command": "powershell -ExecutionPolicy Bypass -File scripts\\deploy-ha-scp.ps1"
        },
        "group": "build",
        "presentation": { "reveal": "always", "panel": "shared" }
      },
      {
        "label": "Run tests",
        "type": "shell",
        "command": ".venv/bin/python -m pytest --tb=short",
        "windows": {
          "command": ".venv\\Scripts\\python.exe -m pytest --tb=short"
        },
        "dependsOrder": "sequence",
        "dependsOn": ["Ensure venv"],
        "group": { "kind": "test", "isDefault": true },
        "presentation": { "reveal": "always", "panel": "shared" }
      },
      {
        "label": "Lint (ruff)",
        "type": "shell",
        "command": ".venv/bin/python -m ruff check custom_components/",
        "windows": {
          "command": ".venv\\Scripts\\python.exe -m ruff check custom_components/"
        },
        "dependsOrder": "sequence",
        "dependsOn": ["Ensure venv"],
        "group": "build",
        "presentation": { "reveal": "always", "panel": "shared" }
      },
      {
        "label": "Clean caches",
        "type": "shell",
        "command": "bash scripts/clean.sh",
        "windows": {
          "command": "powershell -ExecutionPolicy Bypass -File scripts\\clean.ps1"
        },
        "group": "build",
        "presentation": { "reveal": "always", "panel": "shared" }
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.debugpy",
      "charliermarsh.ruff",
      "redhat.vscode-yaml"
    ]
  }
}
